<% layout("/layouts/boilerplate") %>

<div class="n-wide">
  <section class="n-auth" data-reveal-group style="margin-top: var(--n-s5);">

    <div class="n-matte n-matte--haldi n-matte--short n-reveal">
      <div class="n-matte__body">
        <p class="n-label n-on-wash-2">Join Nivasa</p>
        <h1 class="n-display-l n-on-wash">Find a place<br>to belong</h1>
      </div>
    </div>

    <div class="n-auth__form n-reveal">
      <div class="n-stack" style="gap: var(--n-s2);">
        <p class="n-label">Sign up</p>
        <h2 class="n-display-m">Create account</h2>
      </div>

      <form action="/signup" method="POST" class="needs-validation n-auth__fields" novalidate>
        <div class="n-field">
          <label class="n-field__label" for="username">Username</label>
          <input class="n-field__input" type="text" name="username" id="username"
                 placeholder="sahilsharma" required autocomplete="username">
          <div class="invalid-feedback">Username is required</div>
        </div>

        <div class="n-field">
          <label class="n-field__label" for="email">Email address</label>
          <input class="n-field__input" type="email" name="email" id="email"
                 placeholder="you@example.com" required autocomplete="email">
          <div class="invalid-feedback">Enter a valid email</div>
        </div>

        <div class="n-field">
          <label class="n-field__label" for="password">Password</label>
          <input class="n-field__input" type="password" name="password" id="password"
                 placeholder="Choose a password" required autocomplete="new-password">
          <div class="invalid-feedback">Password is required</div>
        </div>

        <div><button class="n-btn" type="submit">Create account</button></div>

        <p class="n-auth__foot">
          Already registered? <a href="/login">Log in</a>
        </p>
      </form>
    </div>

  </section>
</div>
