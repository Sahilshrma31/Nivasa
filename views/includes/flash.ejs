<% if ((success && success.length) || (error && error.length)) { %>
  <div class="n-flash-wrap" id="flashWrap">
    <% if (success && success.length) { %>
      <div class="n-flash n-flash--success" role="status">
        <span class="n-flash__icon">Done</span>
        <span><%= success %></span>
        <button class="n-flash__close" type="button" aria-label="Dismiss">&times;</button>
      </div>
    <% } %>

    <% if (error && error.length) { %>
      <div class="n-flash n-flash--error" role="alert">
        <span class="n-flash__icon">Error</span>
        <span><%= error %></span>
        <button class="n-flash__close" type="button" aria-label="Dismiss">&times;</button>
      </div>
    <% } %>
  </div>
<% } %>
