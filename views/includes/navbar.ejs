<!-- Floating glass pill. Sits ON TOP of the hero wash, inset from the top
     edge — never a solid bar. Search lives in the filter row on /listings,
     not up here. -->
<nav class="n-nav">
  <div class="n-nav__pill" id="navPill">

    <a class="n-nav__brand" href="/listings">Nivasa<sup>&reg;</sup></a>

    <div class="n-nav__links" id="navLinks">
      <a class="n-nav__link" href="/listings">Listings</a>
      <a class="n-nav__link" href="/listings/new">Add</a>
      <% if (currUser) { %>
        <a class="n-nav__link" href="/bookings/mine">Bookings</a>
        <a class="n-nav__link" href="/logout">Log out</a>
      <% } else { %>
        <a class="n-nav__link" href="/signup">Sign up</a>
        <a class="n-nav__link" href="/login">Log in</a>
      <% } %>
    </div>

    <div style="display:flex; align-items:center; gap:0.5rem;">
      <button class="n-nav__icon n-nav__theme" id="themeToggle"
              type="button" aria-label="Switch theme">
        <span class="n-ico-moon" aria-hidden="true">&#9789;</span>
        <span class="n-ico-sun" aria-hidden="true">&#9788;</span>
      </button>

      <button class="n-nav__icon n-nav__burger" id="navBurger"
              type="button" aria-label="Menu" aria-expanded="false"
              aria-controls="navLinks">
        <i class="fas fa-bars" aria-hidden="true"></i>
      </button>
    </div>

  </div>
</nav>
