<% layout("layouts/boilerplate") -%>
<%
  // Bookings made before the schema carried dates have none, so fall back to
  // the day they were created rather than printing "Invalid Date".
  const fmt = (d) => new Date(d).toLocaleDateString("en-IN",
    { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });

  const stay = (b) => b.checkIn && b.checkOut
    ? fmt(b.checkIn) + " \u2192 " + fmt(b.checkOut) +
      "  \u00B7  " + b.nights + (b.nights === 1 ? " night" : " nights")
    : "Booked " + fmt(b.createdAt);
%>

<div class="n-wide">

  <section class="n-matte n-matte--ember n-matte--lead n-matte--short n-matte--centered">
    <div class="n-matte__body">
      <p class="n-label n-on-wash-2">Your stays</p>
      <h1 class="n-display-l n-on-wash">Booked Nivasa</h1>
    </div>
  </section>

  <section class="n-section" data-reveal-group>
    <% if (bookings.length === 0) { %>
      <div class="n-column n-stack n-center n-reveal">
        <p class="n-body">You haven't booked a Nivasa yet.</p>
        <div><a href="/listings" class="n-btn">Browse listings</a></div>
      </div>
    <% } else { %>
      <div class="n-grid">
        <% bookings.filter(function (b) { return b.listing; }).forEach(function (booking) { %>
          <a class="n-card n-reveal" href="/listings/<%= booking.listing._id %>">
            <% if (booking.listing.image && booking.listing.image.url) { %>
              <img class="n-card__media" src="<%= booking.listing.image.url %>"
                   alt="<%= booking.listing.title %>" loading="lazy">
            <% } %>
            <div class="n-card__body">
              <span class="n-card__title"><%= booking.listing.title %></span>
              <span class="n-card__meta">
                <%= booking.listing.location %>
                &nbsp;·&nbsp; &#8377;<%= booking.listing.price.toLocaleString("en-IN") %>
              </span>
              <span class="n-card__meta" style="opacity:0.7;">
                <%= stay(booking) %>
              </span>
            </div>
          </a>
        <% }) %>
      </div>

      <div class="n-column n-stack n-reveal" style="margin-top: var(--n-s6);">
        <p class="n-label">Manage bookings</p>
        <div class="n-reviews">
          <% bookings.forEach(function (booking) { %>
            <div class="n-review" style="flex-direction:row; align-items:center; justify-content:space-between; gap:var(--n-s4);">
              <div class="n-kv">
                <span class="n-kv__k"><%= stay(booking) %></span>
                <span class="n-kv__v" style="font-size:1.0625rem;">
                  <%= booking.listing ? booking.listing.title : "Listing no longer available" %>
                </span>
              </div>
              <form method="POST" action="/bookings/<%= booking._id %>?_method=DELETE">
                <button class="n-review__delete" type="submit">Cancel booking</button>
              </form>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  </section>

</div>
