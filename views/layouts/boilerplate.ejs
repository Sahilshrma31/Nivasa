<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nivasa</title>

  <!-- Stamp the theme BEFORE first paint so there is no flash. Dark is the
       brand default; an explicit choice always beats the OS preference. -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem("nivasa-theme");
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        document.documentElement.setAttribute("data-theme", t);
      } catch (e) {
        document.documentElement.setAttribute("data-theme", "dark");
      }
      // Gate the scroll-reveal styles on JS being alive. Without this,
      // any script failure leaves every .n-reveal block at opacity:0.
      document.documentElement.classList.add("n-js");
    })();
  </script>

  <!-- Fonts: Archivo (display, variable width axis 62-125), Plus Jakarta Sans
       (body), Geist Mono (eyebrows/labels). Montserrat dropped — unused. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..700&family=Geist+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap">

  <!-- CSS. system.css loads LAST so its tokens win without !important. -->
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" />
  <link href="/css/rating.css" rel="stylesheet">
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.5.1/mapbox-gl.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/system.css">

  <script src="https://api.mapbox.com/mapbox-gl-js/v3.5.1/mapbox-gl.js"></script>
</head>

<body>
  <div class="layout-wrapper">

    <!-- Navbar -->
    <%- include('../includes/navbar.ejs') %>

    <!-- Main Content Area. No .container wrapper — the matte hero needs to
         run full-bleed under the floating nav; pages constrain their own
         text columns with .n-inner / .n-wide. -->
    <main class="n-main">
      <div class="n-inner">
        <%- include('../includes/flash.ejs') %>
      </div>
      <%- body %>
    </main>

    <!-- Footer -->
    <%- include('../includes/footer.ejs') %>

  </div>

  <!-- JS Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  <script src="/js/script.js"></script>
  <script src="/js/system.js"></script>
  <!-- Form validation lives in /js/script.js only. It used to be bound here
       and in new.ejs as well, so every form had three identical handlers. -->
</body>
</html>
