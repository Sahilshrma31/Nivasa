<% layout("/layouts/boilerplate") -%>
<%
  // Guards: /listings and /listings/search pass different locals.
  const q     = typeof query    !== "undefined" ? query    : "";
  const minP  = typeof minPrice !== "undefined" ? minPrice : "";
  const maxP  = typeof maxPrice !== "undefined" ? maxPrice : "";
  const srt   = typeof sort     !== "undefined" ? sort     : "";
  const hero  = (allListings && allListings.length && allListings[0].image && allListings[0].image.url)
                  ? allListings[0].image.url : null;
%>

<div class="n-wide">

  <!-- Hero. Path A (gradient) always paints; path B (the <img>) only renders
       when there is art to show, so this can never look broken. -->
  <section class="n-matte n-matte--haldi n-matte--lead n-matte--centered" data-parallax>
    <% if (hero) { %>
      <img class="n-matte__media" src="<%= hero %>" alt="" aria-hidden="true">
    <% } %>
    <div class="n-matte__body">
      <p class="n-label n-on-wash-2">Stays across India</p>
      <h1 class="n-display-xl n-on-wash">Every Nivasa,<br>One Place</h1>
    </div>
  </section>

  <!-- Filter row. Search and price live here now, not in the nav. -->
  <section class="n-section" data-reveal-group>

    <div class="n-pillbar n-reveal">
      <span class="n-pillbar__indicator"></span>
      <a class="n-pill <%= !srt ? 'is-active' : '' %>" href="/listings">All</a>
      <a class="n-pill <%= srt === 'priceLowToHigh' ? 'is-active' : '' %>"
         href="/listings?sort=priceLowToHigh<%= q ? '&search=' + encodeURIComponent(q) : '' %>">&#8377; Low &rarr; High</a>
      <a class="n-pill <%= srt === 'priceHighToLow' ? 'is-active' : '' %>"
         href="/listings?sort=priceHighToLow<%= q ? '&search=' + encodeURIComponent(q) : '' %>">&#8377; High &rarr; Low</a>
    </div>

    <form class="n-reveal" action="/listings" method="GET"
          style="display:grid; grid-template-columns:repeat(auto-fit,minmax(9rem,1fr)); gap:1.5rem; align-items:end; max-width:56rem; margin-inline:auto; width:100%;">
      <div class="n-field">
        <label class="n-field__label" for="search">Search</label>
        <input class="n-field__input" type="text" name="search" id="search"
               placeholder="Search by title" value="<%= q %>">
      </div>
      <div class="n-field">
        <label class="n-field__label" for="minPrice">Min &#8377;</label>
        <input class="n-field__input" type="number" name="minPrice" id="minPrice"
               placeholder="0" value="<%= minP %>">
      </div>
      <div class="n-field">
        <label class="n-field__label" for="maxPrice">Max &#8377;</label>
        <input class="n-field__input" type="number" name="maxPrice" id="maxPrice"
               placeholder="Any" value="<%= maxP %>">
      </div>
      <input type="hidden" name="sort" value="<%= srt %>">
      <button class="n-btn" type="submit">Search</button>
    </form>

    <% if (q || minP || maxP || srt) { %>
      <p class="n-label n-reveal" style="text-align:center;">
        <%
          const bits = [];
          if (q)    bits.push('Keyword: ' + q);
          if (minP) bits.push('Min ₹' + minP);
          if (maxP) bits.push('Max ₹' + maxP);
          if (srt === 'priceLowToHigh') bits.push('Price low to high');
          if (srt === 'priceHighToLow') bits.push('Price high to low');
        %>
        <%= bits.join("  ·  ") %>
      </p>
    <% } %>

  </section>

  <!-- Grid -->
  <% if (allListings && allListings.length === 0) { %>
    <p class="n-body n-reveal" style="text-align:center; margin-inline:auto; padding-block:3rem;">
      No listings match those filters. <a href="/listings">Clear them</a> and start again.
    </p>
  <% } else if (allListings) { %>
    <div class="n-grid" data-reveal-group>
      <% allListings.forEach(function (listing) { %>
        <a class="n-card n-reveal" href="/listings/<%= listing._id %>">
          <% if (listing.image && listing.image.url) { %>
            <img class="n-card__media listing-photo" src="<%= listing.image.url %>"
                 alt="<%= listing.title %>" loading="lazy" decoding="async"
                 style="view-transition-name: photo-<%= listing._id %>">
          <% } %>
          <div class="n-card__body">
            <span class="n-card__title"><%= listing.title %></span>
            <span class="n-card__meta">
              <%= listing.location || listing.country || "India" %>
              &nbsp;·&nbsp;
              &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>
            </span>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>

</div>
