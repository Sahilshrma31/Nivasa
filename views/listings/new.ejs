<% layout("/layouts/boilerplate") %>

<div class="n-wide">

  <section class="n-matte n-matte--ember n-matte--lead n-matte--short n-matte--centered">
    <div class="n-matte__body">
      <p class="n-label n-on-wash-2">Host with Nivasa</p>
      <h1 class="n-display-l n-on-wash">List your place</h1>
    </div>
  </section>

  <section class="n-section" data-reveal-group>
    <div class="n-column n-stack n-reveal">

      <form method="POST" action="/listings" enctype="multipart/form-data"
            novalidate class="needs-validation n-stack">

        <div class="n-field">
          <label class="n-field__label" for="title">Title</label>
          <input class="n-field__input" name="listing[title]" id="title" type="text"
                 placeholder="Hillside Cottage, Manali" required>
          <div class="invalid-feedback">Title is required</div>
        </div>

        <div class="n-field">
          <label class="n-field__label" for="description">Description</label>
          <textarea class="n-field__input" name="listing[description]" id="description"
                    rows="5" placeholder="What makes this place worth the trip?" required></textarea>
          <div class="invalid-feedback">Description is required</div>
          <button type="button" id="generateBtn" class="n-btn n-btn--ghost"
                  style="align-self:flex-start; margin-top:var(--n-s3);">
            <span class="ai-generate-btn__stars" aria-hidden="true">&#10022;</span>
            <span class="ai-generate-btn__text">Write it with AI</span>
          </button>
        </div>

        <div class="n-field">
          <label class="n-field__label" for="image">Listing image</label>
          <input class="n-field__input" name="listing[image]" id="image" type="file" required>
          <div class="invalid-feedback">An image is required</div>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(10rem,1fr)); gap:var(--n-s5);">
          <div class="n-field">
            <label class="n-field__label" for="price">Price per night</label>
            <input class="n-field__input" name="listing[price]" id="price" type="number"
                   placeholder="3400" required>
            <div class="invalid-feedback">Enter a valid price</div>
          </div>

          <div class="n-field">
            <label class="n-field__label" for="location">Location</label>
            <input class="n-field__input" name="listing[location]" id="location" type="text"
                   placeholder="Shimla" required>
            <div class="invalid-feedback">Location is required</div>
          </div>

          <div class="n-field">
            <label class="n-field__label" for="country">Country</label>
            <input class="n-field__input" name="listing[country]" id="country" type="text"
                   placeholder="India" required>
            <div class="invalid-feedback">Country is required</div>
          </div>
        </div>

        <div><button class="n-btn" type="submit">Add listing</button></div>
      </form>

    </div>
  </section>

</div>

<!-- AI status toast -->
<div id="ai-toast" class="ai-toast hidden">
  <div class="ai-toast-icon">&#10022;</div>
  <div class="ai-toast-body">
    <div class="ai-toast-title">AI limit reached</div>
    <div class="ai-toast-message">
      Nivasa has hit its daily AI usage limit. Write the description yourself, or try again tomorrow.
    </div>
  </div>
</div>

<script>
  // Note: form validation is bound once, globally, in /js/script.js.
  const generateBtn = document.getElementById("generateBtn");
  const btnText = generateBtn.querySelector(".ai-generate-btn__text");
  const descriptionField = document.getElementById("description");
  const toast = document.getElementById("ai-toast");

  const toastTitle = toast.querySelector(".ai-toast-title");
  const toastMessage = toast.querySelector(".ai-toast-message");
  let toastTimer;

  // Every failure path shows this. Previously only QUOTA_EXCEEDED did, so a
  // dead API key or an unreachable server looked like "nothing happened".
  function showAiToast(title, message) {
    toastTitle.textContent = title;
    toastMessage.textContent = message;

    clearTimeout(toastTimer);
    toast.classList.remove("hidden");
    requestAnimationFrame(() => toast.classList.add("show"));

    toastTimer = setTimeout(() => {
      toast.classList.remove("show");
      setTimeout(() => toast.classList.add("hidden"), 300);
    }, 6000);
  }

  generateBtn.addEventListener("click", async () => {
    const title = document.getElementById("title").value.trim();
    const location = document.getElementById("location").value.trim();
    const country = document.getElementById("country").value.trim();
    const price = document.getElementById("price").value.trim();

    if (!title || !location || !country || !price) {
      showAiToast(
        "Missing details",
        "Fill in the title, location, country and price first — the AI writes from those."
      );
      return;
    }

    generateBtn.disabled = true;
    btnText.innerText = "Generating...";

    try {
      const res = await fetch("/listings/generate-description", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ title, location, country, price }),
      });

      let data = {};
      try {
        data = await res.json();
      } catch (e) {
        // Server returned an error page rather than JSON.
        data = {};
      }

      if (res.ok && data.success) {
        descriptionField.value = data.description;
        descriptionField.focus();
      } else if (res.status === 429 || data.reason === "QUOTA_EXCEEDED") {
        showAiToast(
          "AI limit reached",
          "Nivasa has hit its daily AI usage limit. Write the description yourself, or try again tomorrow."
        );
      } else {
        showAiToast(
          "Could not generate",
          (data && data.message) ||
            "The AI service did not respond. Write the description yourself, or try again in a moment."
        );
      }
    } catch (err) {
      console.error(err);
      showAiToast(
        "No connection",
        "Could not reach the server. Check your connection and try again."
      );
    } finally {
      // Cooldown to avoid quota abuse
      setTimeout(() => {
        generateBtn.disabled = false;
        btnText.innerText = "Write it with AI";
      }, 6000);
    }
  });
</script>
