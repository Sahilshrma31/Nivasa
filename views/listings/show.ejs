<% layout("/layouts/boilerplate") %>

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="n-wide">

  <!-- Matted header. Same treatment as the landing hero, neem wash, with
       the price pinned top-right and the byline under the title. -->
  <section class="n-matte n-matte--neem n-matte--lead" data-parallax>
    <% if (listing.image && listing.image.url) { %>
      <img class="n-matte__media" src="<%= listing.image.url %>" alt="<%= listing.title %>">
    <% } %>

    <span class="n-matte__tag">
      &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
    </span>

    <div class="n-matte__body">
      <h1 class="n-display-l n-on-wash"><%= listing.title %></h1>
      <p class="n-label n-on-wash-2">
        @<%= listing.owner ? listing.owner.username : "unknown host" %>
        &nbsp;·&nbsp; <%= listing.location %>
        &nbsp;·&nbsp; <%= listing.country %>
      </p>
    </div>
  </section>

  <!-- Body copy in a comfortable centered column -->
  <section class="n-section" data-reveal-group>
    <div class="n-column n-stack">
      <p class="n-label n-reveal">About this Nivasa</p>
      <p class="n-body n-reveal"><%= listing.description %></p>

      <div class="n-kv-row n-reveal">
        <div class="n-kv">
          <span class="n-kv__k">Location</span>
          <span class="n-kv__v"><%= listing.location %></span>
        </div>
        <div class="n-kv">
          <span class="n-kv__k">Country</span>
          <span class="n-kv__v"><%= listing.country %></span>
        </div>
        <div class="n-kv">
          <span class="n-kv__k">Per night</span>
          <span class="n-kv__v" style="font-variant-numeric:tabular-nums;">
            &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>
          </span>
        </div>
      </div>

      <!-- Booking / owner actions -->
      <div class="n-reveal" style="display:flex; gap:0.75rem; flex-wrap:wrap; align-items:center;">
        <% if (!currUser) { %>
          <a href="/login" class="n-btn">Log in to book</a>
        <% } else if (isOwner) { %>
          <a href="/listings/<%= listing._id %>/edit" class="n-btn n-btn--ghost">Edit listing</a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="n-btn n-btn--ghost" type="submit">Delete</button>
          </form>
        <% } else { %>
          <form id="paymentForm" style="display:grid; gap:0.75rem; width:100%; max-width:26rem;">
            <% if (hasBooked) { %>
              <p class="n-label" style="color:var(--n-accent);">You have booked this Nivasa before</p>
            <% } %>

            <div class="n-cal" id="stayCalendar" data-listing="<%= listing._id %>">
              <div class="n-cal__head">
                <button type="button" class="n-cal__nav" data-cal-prev
                        aria-label="Previous month">&lsaquo;</button>
                <span class="n-cal__month"></span>
                <button type="button" class="n-cal__nav" data-cal-next
                        aria-label="Next month">&rsaquo;</button>
              </div>

              <div class="n-cal__dow" aria-hidden="true">
                <span>M</span><span>T</span><span>W</span><span>T</span>
                <span>F</span><span>S</span><span>S</span>
              </div>

              <div class="n-cal__grid"></div>

              <p class="n-cal__hint">Pick your check-in date.</p>

              <div class="n-cal__key">
                <span><i class="k-taken"></i>Booked</span>
                <span><i class="k-yours"></i>Your stay elsewhere</span>
              </div>
            </div>

            <!-- The calendar writes into these; the summary and the pay
                 button read them exactly as they did with date inputs. -->
            <input type="hidden" id="checkIn" name="checkIn">
            <input type="hidden" id="checkOut" name="checkOut">

            <p class="n-body" id="stay-summary" data-price="<%= listing.price %>"
               style="margin:0; min-height:1.4em;">
              &#8377;<%= listing.price.toLocaleString("en-IN") %> per night
            </p>

            <p class="n-booking-msg" id="bookingMsg" role="status"></p>

            <button type="button" class="n-btn" id="rzp-button">Book now</button>
          </form>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="n-section" data-reveal-group>
    <div class="n-inner">
      <div class="n-panel n-reveal">
      <div class="<%= currUser ? 'n-review-layout' : '' %>">

      <% if (currUser) { %>
        <div class="n-review-form">
          <p class="n-label">Leave a review</p>
          <form action="/listings/<%= listing._id %>/reviews" method="POST"
                class="needs-validation n-stack" novalidate>
            <div class="n-field">
              <span class="n-field__label">Rating</span>
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
                       value="0" checked aria-label="No rating." />
                <% for (let i = 1; i <= 5; i++) { %>
                  <input type="radio" id="first-rate<%= i %>" name="review[rating]" value="<%= i %>" />
                  <label for="first-rate<%= i %>"
                         title="<%= ['Terrible','Not good','Average','Very good','Amazing'][i-1] %>"><%= i %> star</label>
                <% } %>
              </fieldset>
            </div>

            <div class="n-field">
              <label class="n-field__label" for="comment">Comments</label>
              <textarea class="n-field__input" name="review[comment]" id="comment"
                        rows="4" placeholder="How was your stay?" required></textarea>
              <div class="invalid-feedback">Please add a comment</div>
            </div>

            <div><button type="submit" class="n-btn">Post review</button></div>
          </form>
        </div>
      <% } %>

      <div class="n-stack">
        <p class="n-label">
          <% if (listing.reviews && listing.reviews.length) { %>
            <%= listing.reviews.length %> review<%= listing.reviews.length === 1 ? "" : "s" %>
          <% } else { %>
            Reviews
          <% } %>
        </p>

        <% if (listing.reviews && listing.reviews.length > 0) { %>
          <div class="n-reviews">
            <% for (let review of listing.reviews) { %>
              <% const author = review.author ? review.author.username : "Deleted user"; %>
              <article class="n-review">
                <div class="n-review__head">
                  <span class="n-review__avatar"><%= author.charAt(0) %></span>
                  <span class="n-review__name"><%= author %></span>
                </div>

                <p class="n-review__text"><%= review.comment %></p>

                <div class="n-review__foot">
                  <fieldset class="starability-result" data-rating="<%= review.rating %>"></fieldset>
                  <% if (currUser && review.author && currUser._id.toString() === review.author._id.toString()) { %>
                    <form method="POST"
                          action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                      <button class="n-review__delete" type="submit">Delete</button>
                    </form>
                  <% } %>
                </div>
              </article>
            <% } %>
          </div>
        <% } else { %>
          <p class="n-body">No reviews yet &mdash; be the first to stay and tell the story.</p>
        <% } %>
      </div>

      </div>
      </div>
    </div>
  </section>

  <!-- Map, in a matte of its own -->
  <section class="n-section" data-reveal-group>
    <div class="n-stack n-reveal">
      <p class="n-label">Where you will be</p>
      <h2 class="n-display-m"><%= listing.location %>, <%= listing.country %></h2>
      <div class="map-section">
        <div class="map-wrapper">
          <div id="map"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stays nearby: closest first, from a $geoNear query on the 2dsphere index -->
  <% if (nearby && nearby.length) { %>
    <section class="n-section" data-reveal-group>
      <div class="n-stack n-reveal">
        <p class="n-label">Within 50 km</p>
        <h2 class="n-display-m">Stays nearby</h2>
      </div>

      <div class="n-grid">
        <% nearby.forEach(function (near) { %>
          <%
            const away = near.distanceM < 1000
              ? "Under 1 km away"
              : (near.distanceM / 1000).toFixed(1) + " km away";
          %>
          <a class="n-card n-reveal" href="/listings/<%= near._id %>">
            <% if (near.image && near.image.url) { %>
              <img class="n-card__media" src="<%= near.image.url %>"
                   alt="<%= near.title %>" loading="lazy">
            <% } %>
            <div class="n-card__body">
              <span class="n-card__title"><%= near.title %></span>
              <span class="n-card__meta">
                <%= away %>
                &nbsp;·&nbsp;
                &#8377;<%= near.price ? near.price.toLocaleString("en-IN") : "N/A" %>
              </span>
            </div>
          </a>
        <% }); %>
      </div>
    </section>
  <% } %>

</div>

<!-- Razorpay Checkout.js -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  const paymentForm = document.getElementById("paymentForm");
  const button = document.getElementById("rzp-button");
  const checkIn = document.getElementById("checkIn");
  const checkOut = document.getElementById("checkOut");
  const staySummary = document.getElementById("stay-summary");

  const NIGHTLY = staySummary ? Number(staySummary.dataset.price) : 0;
  const MS_PER_NIGHT = 24 * 60 * 60 * 1000;

  function resetButton() {
    if (!button) return;
    button.disabled = false;
    button.textContent = "Book now";
  }

  // A browser alert() is a system popup: it looks nothing like the page and
  // it hides the text behind an OK click. Conflict messages name the clashing
  // listing, so they are worth showing properly and leaving on screen.
  const bookingMsg = document.getElementById("bookingMsg");

  function say(message, tone) {
    if (!bookingMsg) return alert(message);
    bookingMsg.textContent = message || "";
    bookingMsg.dataset.tone = tone || "";
  }

  // Mirrors the server's arithmetic so the guest sees the same total before
  // the payment sheet opens. The server still recomputes it — this is display
  // only and is never sent.
  function updateSummary() {
    if (!staySummary || !checkIn || !checkOut) return;

    const inr = (n) => "\u20B9" + n.toLocaleString("en-IN");

    if (!checkIn.value || !checkOut.value) {
      staySummary.textContent = inr(NIGHTLY) + " per night";
      return;
    }

    // Check-out cannot precede check-in, so keep the picker honest as soon as
    // a check-in date is chosen.

    const nights = Math.round(
      (new Date(checkOut.value) - new Date(checkIn.value)) / MS_PER_NIGHT
    );

    if (nights < 1) {
      staySummary.textContent = "Check-out must be after check-in.";
      return;
    }

    staySummary.textContent =
      inr(NIGHTLY) + " \u00D7 " + nights + (nights === 1 ? " night" : " nights") +
      " = " + inr(NIGHTLY * nights);
  }

  if (checkIn && checkOut) {
    checkIn.addEventListener("change", updateSummary);
    checkOut.addEventListener("change", updateSummary);
  }

  if (button) {
    button.onclick = async function (e) {
      e.preventDefault();
      button.disabled = true;
      button.textContent = "Processing...";

      try {
        if (!checkIn.value || !checkOut.value) {
          say("Pick your check-in and check-out dates first.", "bad");
          resetButton();
          return;
        }

        // Only ids and dates go up. Price comes off the listing on the server
        // and the night count from the dates, so nothing here can change what
        // gets charged.
        const res = await fetch("/payments/create-order", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            listingId: "<%= listing._id %>",
            checkIn: checkIn.value,
            checkOut: checkOut.value,
          }),
        });

        const order = await res.json();

        if (!res.ok) {
          // 409 means the dates went while the guest was deciding.
          say(order.error || "Could not start the payment. Please try again.", "bad");
          resetButton();
          return;
        }

        const options = {
          key: "<%= razorpayKeyId %>",
          amount: order.amount,
          currency: "INR",
          name: "Nivasa",
          description: "Booking Payment for <%= listing.title %>",
          order_id: order.id,
          handler: async function (response) {
            try {
              const bookingRes = await fetch("/bookings", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                // Just the proof of payment. Which listing and which dates
                // were bought is read back off the Razorpay order server-side.
                body: JSON.stringify({
                  razorpayPaymentId: response.razorpay_payment_id,
                  razorpayOrderId: response.razorpay_order_id,
                  razorpaySignature: response.razorpay_signature,
                }),
              });

              const bookingData = await bookingRes.json().catch(() => ({}));

              if (bookingRes.ok) {
                window.location.href = "/bookings/mine";
              } else {
                say(
                  bookingData.message ||
                    "Payment went through but the booking did not save. Please contact support.",
                  "bad"
                );
                resetButton();
              }
            } catch (error) {
              console.error("Booking error:", error);
              say("Payment went through but the booking did not save. Please contact support with your payment id.", "bad");
            }
          },
          prefill: {
            name: "<%= currUser ? currUser.username : 'Guest User' %>",
            email: "<%= currUser && currUser.email ? currUser.email : 'guest@example.com' %>",
            contact: "9999999999"
          },
          theme: { color: "#D9552F" },
          modal: {
            ondismiss: function () {
              resetButton();
            }
          }
        };

        const rzp = new Razorpay(options);
        rzp.open();

      } catch (error) {
        console.error("Payment error:", error);
        say("Could not start the payment. Please try again.", "bad");
        resetButton();
      }
    };
  }
</script>

<script src="/js/map.js"></script>
