<% layout("/layouts/boilerplate") %>

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="n-wide">

  <!-- Matted header. Same treatment as the landing hero, neem wash, with
       the price pinned top-right and the byline under the title. -->
  <section class="n-matte n-matte--neem n-matte--lead" data-parallax>
    <% if (listing.image && listing.image.url) { %>
      <img class="n-matte__media" src="<%= listing.image.url %>" alt="<%= listing.title %>">
    <% } %>

    <span class="n-matte__tag">
      &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
    </span>

    <div class="n-matte__body">
      <h1 class="n-display-l n-on-wash"><%= listing.title %></h1>
      <p class="n-label n-on-wash-2">
        @<%= listing.owner ? listing.owner.username : "unknown host" %>
        &nbsp;·&nbsp; <%= listing.location %>
        &nbsp;·&nbsp; <%= listing.country %>
      </p>
    </div>
  </section>

  <!-- Body copy in a comfortable centered column -->
  <section class="n-section" data-reveal-group>
    <div class="n-column n-stack">
      <p class="n-label n-reveal">About this Nivasa</p>
      <p class="n-body n-reveal"><%= listing.description %></p>

      <div class="n-kv-row n-reveal">
        <div class="n-kv">
          <span class="n-kv__k">Location</span>
          <span class="n-kv__v"><%= listing.location %></span>
        </div>
        <div class="n-kv">
          <span class="n-kv__k">Country</span>
          <span class="n-kv__v"><%= listing.country %></span>
        </div>
        <div class="n-kv">
          <span class="n-kv__k">Per night</span>
          <span class="n-kv__v" style="font-variant-numeric:tabular-nums;">
            &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>
          </span>
        </div>
      </div>

      <!-- Booking / owner actions -->
      <div class="n-reveal" style="display:flex; gap:0.75rem; flex-wrap:wrap; align-items:center;">
        <% if (!currUser) { %>
          <a href="/login" class="n-btn">Log in to book</a>
        <% } else if (isOwner) { %>
          <a href="/listings/<%= listing._id %>/edit" class="n-btn n-btn--ghost">Edit listing</a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="n-btn n-btn--ghost" type="submit">Delete</button>
          </form>
        <% } else if (hasBooked) { %>
          <p class="n-label" style="color:var(--n-accent);">You have already booked this Nivasa</p>
        <% } else { %>
          <form id="paymentForm">
            <input type="hidden" name="amount" value="<%= listing.price %>">
            <button type="button" class="n-btn" id="rzp-button">
              Book now &mdash; &#8377;<%= listing.price.toLocaleString("en-IN") %>
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="n-section" data-reveal-group>
    <div class="n-inner">
      <div class="n-panel n-reveal">
      <div class="<%= currUser ? 'n-review-layout' : '' %>">

      <% if (currUser) { %>
        <div class="n-review-form">
          <p class="n-label">Leave a review</p>
          <form action="/listings/<%= listing._id %>/reviews" method="POST"
                class="needs-validation n-stack" novalidate>
            <div class="n-field">
              <span class="n-field__label">Rating</span>
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
                       value="0" checked aria-label="No rating." />
                <% for (let i = 1; i <= 5; i++) { %>
                  <input type="radio" id="first-rate<%= i %>" name="review[rating]" value="<%= i %>" />
                  <label for="first-rate<%= i %>"
                         title="<%= ['Terrible','Not good','Average','Very good','Amazing'][i-1] %>"><%= i %> star</label>
                <% } %>
              </fieldset>
            </div>

            <div class="n-field">
              <label class="n-field__label" for="comment">Comments</label>
              <textarea class="n-field__input" name="review[comment]" id="comment"
                        rows="4" placeholder="How was your stay?" required></textarea>
              <div class="invalid-feedback">Please add a comment</div>
            </div>

            <div><button type="submit" class="n-btn">Post review</button></div>
          </form>
        </div>
      <% } %>

      <div class="n-stack">
        <p class="n-label">
          <% if (listing.reviews && listing.reviews.length) { %>
            <%= listing.reviews.length %> review<%= listing.reviews.length === 1 ? "" : "s" %>
          <% } else { %>
            Reviews
          <% } %>
        </p>

        <% if (listing.reviews && listing.reviews.length > 0) { %>
          <div class="n-reviews">
            <% for (let review of listing.reviews) { %>
              <% const author = review.author ? review.author.username : "Deleted user"; %>
              <article class="n-review">
                <div class="n-review__head">
                  <span class="n-review__avatar"><%= author.charAt(0) %></span>
                  <span class="n-review__name"><%= author %></span>
                </div>

                <p class="n-review__text"><%= review.comment %></p>

                <div class="n-review__foot">
                  <fieldset class="starability-result" data-rating="<%= review.rating %>"></fieldset>
                  <% if (currUser && review.author && currUser._id.toString() === review.author._id.toString()) { %>
                    <form method="POST"
                          action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                      <button class="n-review__delete" type="submit">Delete</button>
                    </form>
                  <% } %>
                </div>
              </article>
            <% } %>
          </div>
        <% } else { %>
          <p class="n-body">No reviews yet &mdash; be the first to stay and tell the story.</p>
        <% } %>
      </div>

      </div>
      </div>
    </div>
  </section>

  <!-- Map, in a matte of its own -->
  <section class="n-section" data-reveal-group>
    <div class="n-stack n-reveal">
      <p class="n-label">Where you will be</p>
      <h2 class="n-display-m"><%= listing.location %>, <%= listing.country %></h2>
      <div class="map-section">
        <div class="map-wrapper">
          <div id="map"></div>
        </div>
      </div>
    </div>
  </section>

</div>

<!-- Razorpay Checkout.js -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  const paymentForm = document.getElementById("paymentForm");
  const button = document.getElementById("rzp-button");

  if (button) {
    button.onclick = async function (e) {
      e.preventDefault();
      button.disabled = true;
      button.textContent = "Processing...";

      try {
        // Only the id goes up. The server reads the price off the listing so a
        // tampered amount here cannot change what gets charged.
        const res = await fetch("/payments/create-order", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ listingId: "<%= listing._id %>" }),
        });

        if (!res.ok) throw new Error("Failed to create order");

        const order = await res.json();

        const options = {
          key: "<%= razorpayKeyId %>",
          amount: order.amount,
          currency: "INR",
          name: "Nivasa",
          description: "Booking Payment for <%= listing.title %>",
          order_id: order.id,
          handler: async function (response) {
            try {
              const bookingRes = await fetch("/bookings", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  listingId: "<%= listing._id %>",
                  razorpayPaymentId: response.razorpay_payment_id,
                  razorpayOrderId: response.razorpay_order_id,
                  // The server recomputes this signature to confirm Razorpay
                  // really took the payment.
                  razorpaySignature: response.razorpay_signature,
                }),
              });

              if (bookingRes.ok) {
                window.location.href = "/bookings/mine";
              } else {
                alert("Payment successful but booking failed. Please contact support.");
              }
            } catch (error) {
              console.error("Booking error:", error);
              alert("Payment successful but booking failed. Please contact support.");
            }
          },
          prefill: {
            name: "<%= currUser ? currUser.username : 'Guest User' %>",
            email: "<%= currUser && currUser.email ? currUser.email : 'guest@example.com' %>",
            contact: "9999999999"
          },
          theme: { color: "#D9552F" },
          modal: {
            ondismiss: function () {
              button.disabled = false;
              button.textContent = "Book now — ₹<%= listing.price.toLocaleString('en-IN') %>";
            }
          }
        };

        const rzp = new Razorpay(options);
        rzp.open();

      } catch (error) {
        console.error("Payment error:", error);
        alert("Failed to initiate payment. Please try again.");
        button.disabled = false;
        button.textContent = "Book now — ₹<%= listing.price.toLocaleString('en-IN') %>";
      }
    };
  }
</script>

<script src="/js/map.js"></script>
